<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.ibm.cos.v2</groupId>
        <artifactId>services</artifactId>
        <version>0.0.1</version>
    </parent>
    <artifactId>kms</artifactId>
    <name>IBM COS Java SDK :: Services :: IBM COS KMS</name>
    <description>The IBM COS Java SDK for IBM COS KMS module holds the client classes that are used for communicating with IBM COS
        Key Management Service
    </description>
    <url>https://github.com/ibm/ibm-cos-sdk-java-v2</url>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>com.ibm.cos.v2.services.kms</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>com.ibm.cos.v2</groupId>
            <artifactId>aws-json-protocol</artifactId>
            <version>${ibmcosjavasdk.version}</version>
        </dependency>
        <dependency>
            <groupId>com.ibm.cos.v2</groupId>
            <artifactId>protocol-core</artifactId>
            <version>${ibmcosjavasdk.version}</version>
        </dependency>
        <dependency>
            <groupId>com.ibm.cos.v2</groupId>
            <artifactId>http-auth-aws</artifactId>
            <version>${ibmcosjavasdk.version}</version>
        </dependency>
    </dependencies>
</project>
