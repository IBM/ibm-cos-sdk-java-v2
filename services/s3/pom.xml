<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.ibm.cos.v2</groupId>
        <artifactId>services</artifactId>
        <version>1.0.1</version>
    </parent>
    <artifactId>s3</artifactId>
    <name>IBM COS Java SDK :: Services :: IBM COS S3</name>
    <description>The IBM COS Java SDK for IBM COS S3 module holds the client classes that are used for communicating with
        IBM COS Simple Storage Service
    </description>
    <url>https://github.com/ibm/ibm-cos-sdk-java-v2</url>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>com.ibm.cos.v2.services.s3</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <configuration>
                    <ignoredUsedUndeclaredDependencies>
                        <ignoredUnusedDeclaredDependency>org.junit.jupiter:*</ignoredUnusedDeclaredDependency>
                    </ignoredUsedUndeclaredDependencies>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>com.ibm.cos.v2</groupId>
            <artifactId>aws-xml-protocol</artifactId>
            <version>${ibmcosjavasdk.version}</version>
        </dependency>
        <dependency>
            <groupId>com.ibm.cos.v2</groupId>
            <artifactId>protocol-core</artifactId>
            <version>${ibmcosjavasdk.version}</version>
        </dependency>
        <dependency>
            <groupId>com.ibm.cos.v2</groupId>
            <artifactId>arns</artifactId>
            <version>${ibmcosjavasdk.version}</version>
        </dependency>
        <dependency>
            <groupId>com.ibm.cos.v2</groupId>
            <artifactId>profiles</artifactId>
            <version>${ibmcosjavasdk.version}</version>
        </dependency>
        <dependency>
            <groupId>com.ibm.cos.v2</groupId>
            <artifactId>http-auth</artifactId>
            <version>${ibmcosjavasdk.version}</version>
        </dependency>
        <dependency>
            <groupId>com.ibm.cos.v2</groupId>
            <artifactId>identity-spi</artifactId>
            <version>${ibmcosjavasdk.version}</version>
        </dependency>
        <dependency>
            <groupId>com.ibm.cos.v2</groupId>
            <artifactId>http-auth-spi</artifactId>
            <version>${ibmcosjavasdk.version}</version>
        </dependency>
        <dependency>
            <groupId>com.ibm.cos.v2</groupId>
            <artifactId>http-auth-aws</artifactId>
            <version>${ibmcosjavasdk.version}</version>
        </dependency>
        <dependency>
            <groupId>com.ibm.cos.v2</groupId>
            <artifactId>checksums</artifactId>
            <version>${ibmcosjavasdk.version}</version>
        </dependency>
        <dependency>
            <groupId>com.ibm.cos.v2</groupId>
            <artifactId>checksums-spi</artifactId>
            <version>${ibmcosjavasdk.version}</version>
        </dependency>
        <dependency>
            <groupId>com.ibm.cos.v2</groupId>
            <artifactId>retries-spi</artifactId>
            <version>${ibmcosjavasdk.version}</version>
        </dependency>
        <!-- Test Dependencies -->
        <dependency>
            <artifactId>commons-io</artifactId>
            <groupId>commons-io</groupId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk.crt</groupId>
            <artifactId>aws-crt</artifactId>
            <version>${aws-crt.version}</version>
            <!-- Only required for certain features such as S3 CRT client -->
            <optional>true</optional>
        </dependency>
        <dependency>
            <artifactId>kms</artifactId>
            <groupId>com.ibm.cos.v2</groupId>
            <version>${ibmcosjavasdk.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.18.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.github.tomakehurst</groupId>
            <artifactId>wiremock-jre8</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.reactivestreams</groupId>
            <artifactId>reactive-streams-tck</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.ibm.cos.v2</groupId>
            <artifactId>auth-crt</artifactId>
            <version>${ibmcosjavasdk.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.ibm.cos.v2</groupId>
            <artifactId>http-auth-aws-crt</artifactId>
            <version>${ibmcosjavasdk.version}</version>
            <scope>test</scope>
        </dependency>
        <!--<dependency>
            <groupId>com.ibm.cos.v2</groupId>
            <artifactId>aws-crt-client</artifactId>
            <version>${ibmcosjavasdk.version}</version>
            <scope>test</scope>
        </dependency> -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>nl.jqno.equalsverifier</groupId>
            <artifactId>equalsverifier</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-inline</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.jimfs</groupId>
            <artifactId>jimfs</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
