<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ibm.cos.v2</groupId>
        <artifactId>core</artifactId>
        <version>0.0.1</version>
    </parent>

    <artifactId>ibmOAuth</artifactId>
    <name>AWS Java SDK :: IBM OAuth Auth Support</name>
    <description>Custom module to support IBM IAM auth with AWS SDK v2.</description>

    <dependencies>
        <!-- IBM SDK Core for IAM -->
        <dependency>
            <groupId>com.ibm.cloud</groupId>
            <artifactId>sdk-core</artifactId>
            <version>9.23.1</version>
        </dependency>

        <!-- AWS SDK modules required -->
        <dependency>
            <groupId>com.ibm.cos.v2</groupId>
            <artifactId>sdk-core</artifactId>
            <version>${ibmcosjavasdk.version}</version>
        </dependency>
        <dependency>
            <groupId>com.ibm.cos.v2</groupId>
            <artifactId>auth</artifactId>
            <version>${ibmcosjavasdk.version}</version>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Allows ignoring unused dependency warnings -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <configuration>
                    <ignoredUnusedDeclaredDependencies>
                        <ignoredUnusedDeclaredDependency>com.ibm.cloud:sdk-core</ignoredUnusedDeclaredDependency>
                    </ignoredUnusedDeclaredDependencies>
                </configuration>
            </plugin>

            <!-- Allows running main() from VSCode or command line -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>com.ibm.cos.v2.auth.credentials.ibmOAuth.IAMUnitTest</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
