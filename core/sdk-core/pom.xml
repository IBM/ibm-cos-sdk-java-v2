            <groupId>com.ibm.cos.v2</groupId>
            <artifactId>http-auth-spi</artifactId>
            <version>1.0.0</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>com.ibm.cos.v2</groupId>
            <artifactId>http-auth-aws</artifactId>
            <version>1.0.0</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>com.ibm.cos.v2</groupId>
            <artifactId>ibmConfig</artifactId>
            <version>${ibmcosjavasdk.version}</version>
