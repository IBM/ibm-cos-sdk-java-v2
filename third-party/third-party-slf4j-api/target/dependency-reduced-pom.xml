<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <parent>
    <artifactId>third-party</artifactId>
    <groupId>com.ibm.cos.v2</groupId>
    <version>1.0.2</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <modelVersion>4.0.0</modelVersion>
  <artifactId>third-party-slf4j-api</artifactId>
  <name>IBM COS Java SDK :: Third Party :: SLF4J API</name>
  <url>https://github.com/ibm/ibm-cos-sdk-java-v2</url>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <artifactSet>
            <includes>
              <include>org.slf4j:*</include>
            </includes>
          </artifactSet>
          <relocations>
            <relocation>
              <pattern>org.slf4j</pattern>
              <shadedPattern>com.ibm.cos.v2.thirdparty.org.slf4j</shadedPattern>
            </relocation>
          </relocations>
          <filters>
            <filter>
              <artifact>org.slf4j:*</artifact>
              <excludes>
                <exclude>META-INF/**/pom.xml</exclude>
                <exclude>META-INF/**/pom.properties</exclude>
                <exclude>META-INF/versions/**/*.class</exclude>
              </excludes>
            </filter>
          </filters>
          <transformers>
            <transformer />
          </transformers>
          <shadedArtifactAttached>false</shadedArtifactAttached>
          <createDependencyReducedPom>true</createDependencyReducedPom>
          <dependencyReducedPomLocation>${project.build.directory}/dependency-reduced-pom.xml</dependencyReducedPomLocation>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>com.ibm.cos.v2.thirdparty.slf4j</Automatic-Module-Name>
            </manifestEntries>
            <manifest>
              <addDefaultEntries>false</addDefaultEntries>
            </manifest>
            <addMavenDescriptor>false</addMavenDescriptor>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-javadoc-plugin</artifactId>
        <executions>
          <execution>
            <id>javadoc-jar</id>
            <phase>package</phase>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <sourcepath>${basedir}/../../core/profiles/src/main/java/com/ibm/cos/v2/profiles;${basedir}/../../core/sdk-core/src/main/java/com/ibm/cos/v2/core</sourcepath>
          <failOnError>false</failOnError>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.2.1</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <phase>package</phase>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <includeEmptyDirs>true</includeEmptyDirs>
          <forceCreation>true</forceCreation>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.ibm.cos.v2</groupId>
        <artifactId>bom-internal</artifactId>
        <version>${project.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
